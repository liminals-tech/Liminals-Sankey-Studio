# Public Supabase project settings for the shared chart gallery.
# These values are safe to expose client-side by design (anon/publishable
# key), access control is enforced by the database's row-level security.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: activates sign-in and the "private export" option for registered
# users. Leave blank to keep the app fully public and anonymous, as it is by
# default. Also requires adding Clerk as a Third-Party Auth integration in
# the Supabase dashboard (Authentication -> Third-Party Auth) so Supabase
# trusts Clerk-issued session tokens -- without that step, sign-in works but
# private charts won't be readable by their own owner.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
